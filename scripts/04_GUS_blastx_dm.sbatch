#!/bin/bash
#SBATCH --job-name=GUS_blastx
#SBATCH --output=/data/home/molivares/elena/glucuronidases/logs/GUS_%A_%a.out
#SBATCH --error=/data/home/molivares/elena/glucuronidases/logs/GUS_%A_%a.err
#SBATCH --time=12:00:00
#SBATCH --cpus-per-task=8
#SBATCH --array=1-48%4

set -euo pipefail

# --------------------------------------------------
# DIRECTORIES
# --------------------------------------------------

PROJECT_DIR="/data/home/molivares/elena/glucuronidases"

METADATA="${PROJECT_DIR}/data/samples.tsv"

INPUT_DIR="${PROJECT_DIR}/data/processed/non_human"
FASTA_DIR="${PROJECT_DIR}/data/processed/non_human/fasta"

DB_PREFIX="${PROJECT_DIR}/data/references/diamond_db/HMGC279"

RESULTS="${PROJECT_DIR}/results/GUS_diamond"
TMP_DIR="${RESULTS}/tmp"

THREADS="${SLURM_CPUS_PER_TASK:-8}"

mkdir -p "${RESULTS}" "${TMP_DIR}"

# --------------------------------------------------
# LOAD MODULE
# --------------------------------------------------

module purge
module load DIAMOND/2.1.11-GCC-13.3.0

echo "DIAMOND version:"
diamond version

# --------------------------------------------------
# CHECK DATABASE
# --------------------------------------------------

if [[ ! -s "${DB_PREFIX}.dmnd" ]]; then
    echo "ERROR: DIAMOND database not found: ${DB_PREFIX}.dmnd"
    exit 1
fi

# --------------------------------------------------
# READ SAMPLE INFORMATION
# --------------------------------------------------

if [[ ! -f "${METADATA}" ]]; then
    echo "ERROR: Metadata file not found: ${METADATA}"
    exit 1
fi

SAMPLE_LINE=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "${METADATA}")

if [[ -z "${SAMPLE_LINE}" ]]; then
    echo "ERROR: No sample found for task ${SLURM_ARRAY_TASK_ID}"
    exit 1
fi

IFS=$'\t' read -r SAMPLE ORIGINAL_FASTQ <<< "${SAMPLE_LINE}"

if [[ -z "${SAMPLE}" || -z "${ORIGINAL_FASTQ}" ]]; then
    echo "ERROR: Invalid metadata line"
    exit 1
fi

# Remove possible Windows carriage return
SAMPLE="${SAMPLE//$'\r'/}"
ORIGINAL_FASTQ="${ORIGINAL_FASTQ//$'\r'/}"

# Input generated by the previous host-removal pipeline
INPUT_FASTQ="${INPUT_DIR}/${SAMPLE}.nonhuman.fastq.gz"

if [[ ! -s "${INPUT_FASTQ}" ]]; then
    echo "ERROR: Non-human FASTQ not found: ${INPUT_FASTQ}"
    exit 1
fi





# ============================================================
# 4. CONVERTIR FASTQ.GZ A FASTA
# ============================================================

OUTPUT_FASTA="${FASTA_DIR}/${SAMPLE}.nonhuman.fasta"

echo "Converting FASTQ.GZ to FASTA..."

if [[ ! -s "${OUTPUT_FASTA}" ]]; then

    TEMP_FASTA="${OUTPUT_FASTA}.tmp"
    # Cada lectura FASTQ ocupa cuatro líneas:
    # 1: identificador (@)
    # 2: secuencia
    # 3: separador (+)
    # 4: calidad
    #
    # Conservamos identificador y secuencia.

    zcat "${INPUT_FASTQ}" | awk '
    NR%4==1 {
        print ">" substr($0,2)
    }
    NR%4==2 {
        print
    }
    ' > "${TEMP_FASTA}"

    if [[ ! -s "${TEMP_FASTA}" ]]; then
        echo "ERROR: FASTA conversion failed for ${SAMPLE}"
        rm -f "${TEMP_FASTA}"
        exit 1
    fi

    mv "${TEMP_FASTA}" "${OUTPUT_FASTA}"

else
    echo "FASTA already exists. Skipping conversion."
fi

echo "FASTA generated: ${OUTPUT_FASTA}"

# ============================================================
# 5. EJECUTAR DIAMOND BLASTX
# ============================================================

OUTPUT_TSV="${RESULTS}/${SAMPLE}.GUS.tsv"

echo "Running DIAMOND blastx..."

diamond blastx \
    --query "${OUTPUT_FASTA}" \
    --db "${DB_PREFIX}" \
    --out "${OUTPUT_TSV}" \
    --outfmt 6 qseqid sseqid pident length qstart qend sstart send evalue bitscore qlen slen \
    --sensitive \
    --evalue 1e-5 \
    --max-target-seqs 25 \
    --threads "${THREADS}"

echo "DIAMOND finished for ${SAMPLE}"

# ============================================================
# 6. RESUMEN
# ============================================================

N_READS=$(grep -c "^>" "${OUTPUT_FASTA}" || true)
N_HITS=$(wc -l < "${OUTPUT_TSV}")

echo "=========================================="
echo "RESULTS: ${SAMPLE}"
echo "Reads processed: ${N_READS}"
echo "GUS alignments: ${N_HITS}"
echo "Output: ${OUTPUT_TSV}"
echo "Finished: $(date)"
echo "=========================================="


